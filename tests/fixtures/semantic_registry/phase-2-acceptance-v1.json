            }
        },
        {
            "case_id": "case-temporal-timezone-explicit-offset",
            "requirement": "b1-timezone-handling",
            "description": "Source text carrying an explicit UTC offset is normalized to canonical UTC without guessing timezone.",
            "input": {
                "boundary_id": "temporal-timezone-0001",
                "valid_from": {
                    "state": "stated",
                    "source_text": "2024-05-17T09:30:00-05:00",
                    "precision": "minute",
                    "timezone_kind": "explicit_offset"
                },
                "valid_to": {
                    "state": "open"
                }
            },
            "expected_result": {
