            "expected_result": {
                "outcome": "resolved",
                "effective_from": "2024-05-17T00:00:00Z",
                "canonical_precision": "day",
                "preserved_source_text": "PLACEHOLDER_SOURCE_TEXT_2024_05_17"
            }
        },
        {
            "case_id": "case-temporal-precision-hour",
