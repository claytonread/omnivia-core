# Dependencies
node_modules/
.venv/
.venv*/
venv/

# Build outputs
dist/
build/
*.egg-info/

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local environment and secrets
.env
.env.*
!.env.example
*.secret
*secret*
*.pem
*.key

# One governed Host Contract v1 fixture is named for the thing it forbids. It is
# the approved negative case (DOC-004 section AA) proving an EnvironmentBinding
# carrying an inline secret is rejected, and its value is the placeholder
# "forbidden-inline-value", not a credential. Without this exact-path exception
# the `*secret*` rule above makes the approved bytes untrackable: the working
# tree passes every check and a fresh clone is missing a fixture. The exception
# is one path, so `*secret*` still applies everywhere else.
!contracts/host/v1/fixtures/invalid/environment-binding-inline-secret.json

# Local data
data/*
!data/.gitignore
*.sqlite
*.sqlite3

# OS/editor artifacts
.DS_Store
*.swp
*.swo

# Private operating/planning material belongs in omnivia-pm
.claude/
bootstrap/
context/
ops/
prompts/
product/
features/
specs/

# External reference material stays local unless explicitly promoted
external/reference/*
!external/reference/.gitkeep
external/vendor/*
!external/vendor/.gitkeep
external/sidecars/*
!external/sidecars/.gitkeep
