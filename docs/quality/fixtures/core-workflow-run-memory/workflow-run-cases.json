      "case_id": "RUN-V-15",
      "title": "Cancellation racing an in-flight mutation is resolved by Core",
      "category": "cancellation_race",
      "requirements": ["RUN-R-17", "RUN-R-18"],
      "provisional_dependencies": ["RUN-P-05"],
      "run_context": {
        "run_id": "run.a8-0006",
        "task_node_id": "node.051",
        "agent_id": "agent.synthetic.a8",
        "session_id": "session.a8-0009",
        "caller_principal_kind": "agent",
        "bound_workspace_id": "ws.a8-alpha"
      },
      "ingress": {
        "operation": "memory.create",
        "requested_workspace_id": "ws.a8-alpha",
        "granted_capabilities": ["memory.write"],
        "purpose": "agent.knowledge_capture",
        "idempotency_key": "run.a8-0006:node.051:db77"
      },
      "stimulus": "The run is cancelled by its host while a memory.create request is in flight and the response is never observed.",
      "expected": {
        "disposition": "indeterminate_until_reconciled",
        "core_mutation": null,
        "canonical_mutation": false,
        "mutation_authority": "none",
        "core_audit_event": null,
        "fail_closed": true,
        "reconciliation_branches": [
          {
            "branch_id": "committed_once",
            "core_mutation": true,
            "canonical_mutation": false,
            "core_audit_event": true,
            "note": "Core had already committed the candidate when the cancellation was observed. Cancelling the run is host-local and does not roll that back; reconciliation replays the derived key and is returned the same committed result."
          },
          {
            "branch_id": "not_committed",
            "core_mutation": false,
            "canonical_mutation": false,
            "core_audit_event": false,
            "note": "The attempt never committed, so no candidate and no mutation audit entry exist for it. Reconciliation replays the derived key, which creates the candidate exactly once; that reconciling ingress is itself audited."
          }
        ],
        "notes": "The runtime must not assume either outcome, so no Core-effect Boolean is fixed here. Both branches are legitimate and are enumerated instead. Canonical mutation stays false in both: the operation is memory.create under an agent actor, so no branch can carry governance authority."
      }
    },
