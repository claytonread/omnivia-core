  "$defs": {
    "OperationSideEffect": {
      "title": "OperationSideEffect",
      "description": "Open, dot-namespaced code naming whether invoking an operation mutates state, such as `none` or `create` or `update` or `delete`. Open by design so a compatible minor release can add classifications without breaking existing decoders.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
    },
    "OperationScopeKind": {
      "title": "OperationScopeKind",
      "description": "Open, dot-namespaced code naming the kind of scope an operation carries, such as `installation` or `workspace`. Open by design so a compatible minor release can add scope kinds without breaking existing decoders. A given operation's scope metadata carries exactly one kind.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
    },
    "OperationScope": {
      "title": "OperationScope",
      "description": "What an operation itself declares it needs and touches, independent of any single caller's request.",
      "type": "object",
      "properties": {
        "required_scopes": {
          "type": "array",
          "description": "Scopes a caller must hold to invoke this operation.",
          "items": {
            "$ref": "https://contracts.omnivia.dev/application/v1/common.schema.json#/$defs/Scope"
          },
          "maxItems": 64
        },
        "side_effect": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationSideEffect",
          "description": "Whether invoking this operation mutates state."
        },
        "scope_kind": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationScopeKind",
          "description": "The single scope kind this operation requires, such as `installation` or `workspace`."
        }
      },
      "required": ["required_scopes", "side_effect", "scope_kind"],
      "unevaluatedProperties": false
    },
    "OperationCompletionMode": {
      "title": "OperationCompletionMode",
      "description": "Open, dot-namespaced code naming how an operation completes, such as `synchronous` (no durable job, ever), `may_return_job` (a response may carry a `JobReference`), or `always_returns_job` (every invocation starts a durable job). Independent of `OperationSideEffect`: an operation like `import.start` is representable as a mutation (`side_effect`) that always returns a durable job (`completion_mode`). Open by design so a compatible minor release can add modes without breaking existing decoders.",
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)*$(?![\\s\\S])"
    },
    "OperationJobMetadata": {
      "title": "OperationJobMetadata",
      "description": "How an operation completes and, when durable work is involved, what kind of job it starts.",
      "type": "object",
      "properties": {
        "completion_mode": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationCompletionMode",
          "description": "How this operation completes: synchronously, optionally through a job, or always through a job."
        },
        "job_kind": {
          "$ref": "https://contracts.omnivia.dev/application/v1/common.schema.json#/$defs/OpenCode",
          "description": "Open code naming the kind of job this operation starts, when `completion_mode` entails one."
        },
        "terminal_result_schema_ref": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/SchemaReference",
          "description": "Reference to the JSON Schema governing `JobTerminalSuccess.result` for the job this operation starts. This is what makes terminal success typed rather than opaque: `result_kind` names the shape and this reference resolves it. Present exactly when `completion_mode` entails a durable job: in the v1 catalogue that is `import.start` alone, bound to `ImportCompletionResult`. A synchronous operation omits it, along with `job_kind`."
        }
      },
      "required": ["completion_mode"],
      "unevaluatedProperties": false
    },
    "OperationPaginationMetadata": {
      "title": "OperationPaginationMetadata",
      "description": "Whether and how an operation's results are paginated.",
      "type": "object",
      "properties": {
        "paginated": {
          "type": "boolean",
          "description": "Whether this operation's result may span more than one page."
        },
        "max_page_size": {
          "type": "integer",
          "description": "Largest page size this operation accepts, when paginated.",
          "minimum": 1
        }
      },
      "required": ["paginated"],
      "unevaluatedProperties": false
    },
    "OperationIdempotencyMetadata": {
      "title": "OperationIdempotencyMetadata",
      "description": "How this operation may safely be retried. The three fields are not independent: `required` entails `supports_idempotency_key` (an operation cannot demand a key it does not honour), `safe_to_retry` excludes `required` (a request that is safe to repeat without a key cannot also be rejected for lacking one), and an operation that does not support keys cannot require them. A combination breaking any of those is a metadata statement no implementation can satisfy.",
      "type": "object",
      "properties": {
        "supports_idempotency_key": {
          "type": "boolean",
          "description": "Whether this operation honours `RequestMetadata.idempotency_key`."
        },
        "required": {
          "type": "boolean",
          "description": "Whether omitting the idempotency key is itself rejected. A mutation that starts durable work or changes a job's control state requires one, so a network-level repeat can never become a second mutation; omitting it is a non-retryable invalid request, not a silently accepted single-shot call."
        },
        "safe_to_retry": {
          "type": "boolean",
          "description": "Whether an identical request may be retried without an idempotency key, such as a plain read."
        }
      },
      "required": ["supports_idempotency_key", "required", "safe_to_retry"],
      "unevaluatedProperties": false
    },
    "OperationPreconditionMetadata": {
      "title": "OperationPreconditionMetadata",
      "description": "How this operation uses optimistic-concurrency preconditions.",
      "type": "object",
      "properties": {
        "supports_mutation_precondition": {
          "type": "boolean",
          "description": "Whether this operation honours `RequestMetadata.mutation_precondition`."
        },
        "required": {
          "type": "boolean",
          "description": "Whether omitting the precondition is itself rejected for this mutation."
        }
      },
      "required": ["supports_mutation_precondition", "required"],
      "unevaluatedProperties": false
    },
    "OperationAuditMetadata": {
      "title": "OperationAuditMetadata",
      "description": "Whether and how this operation is audited.",
      "type": "object",
      "properties": {
        "audited": {
          "type": "boolean",
          "description": "Whether invoking this operation produces an audit record."
        },
        "audit_category": {
          "$ref": "https://contracts.omnivia.dev/application/v1/common.schema.json#/$defs/OpenCode",
          "description": "Open code categorizing this operation's audit records, when audited."
        }
      },
      "required": ["audited"],
      "unevaluatedProperties": false
    },
    "SchemaReference": {
      "title": "SchemaReference",
      "description": "A URI reference to the JSON Schema document governing an operation's input or result payload.",
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "OperationMetadata": {
      "title": "OperationMetadata",
      "description": "The full declared contract characteristics of one operation: its scope, payload schemas, required capability, side effects, and job/pagination/idempotency/precondition/audit/error posture. Every entry of this document's `x-omnivia-operation-catalogue` is exactly one of these, so the catalogue is metadata a caller can read rather than behaviour it has to discover. `allowed_errors` is materialized per operation: reusable error postures exist in the specification that froze this catalogue, but never on the wire, so no decoder has to resolve a profile name to know what an operation may fail with.",
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://contracts.omnivia.dev/application/v1/envelopes.schema.json#/$defs/OperationName",
          "description": "Operation this metadata describes."
        },
        "scope": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationScope",
          "description": "What this operation requires and touches."
        },
        "input_schema_ref": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/SchemaReference",
          "description": "Reference to the JSON Schema governing this operation's `input` payload."
        },
        "result_schema_ref": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/SchemaReference",
          "description": "Reference to the JSON Schema governing this operation's `result` payload."
        },
        "required_capability": {
          "$ref": "https://contracts.omnivia.dev/application/v1/compatibility.schema.json#/$defs/CapabilityRequirement",
          "description": "The capability, and minimum version, this operation depends on."
        },
        "job": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationJobMetadata",
          "description": "How this operation completes and whether it may return asynchronous work."
        },
        "pagination": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationPaginationMetadata",
          "description": "Whether and how this operation's results are paginated."
        },
        "idempotency": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationIdempotencyMetadata",
          "description": "How this operation may safely be retried."
        },
        "precondition": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationPreconditionMetadata",
          "description": "How this operation uses optimistic-concurrency preconditions."
        },
        "audit": {
          "$ref": "https://contracts.omnivia.dev/application/v1/operations.schema.json#/$defs/OperationAuditMetadata",
          "description": "Whether and how this operation is audited."
        },
        "allowed_errors": {
          "type": "array",
          "description": "The stable error codes this operation may fail with.",
          "items": {
            "$ref": "https://contracts.omnivia.dev/application/v1/errors.schema.json#/$defs/ErrorCode"
          },
          "maxItems": 64
        }
      },
      "required": [
        "name",
        "scope",
        "input_schema_ref",
        "result_schema_ref",
        "required_capability",
        "job",
        "pagination",
        "idempotency",
        "precondition",
        "audit",
        "allowed_errors"
      ],
      "unevaluatedProperties": false
    }
  }
}
