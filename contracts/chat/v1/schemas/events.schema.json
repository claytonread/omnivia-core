    "BranchHeadAdvancedEvent": {
      "title": "BranchHeadAdvancedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "cause", "conversationId", "conversationSequence", "cursor", "eventId", "eventType", "graphRevision", "headVersion", "newHeadMessageId", "occurredAt", "schemaVersion", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.branch.head_advanced" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "headVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/HeadVersion" },
        "newHeadMessageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "cause": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchHeadCause" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "conversationSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "BranchSelectedEvent": {
      "title": "BranchSelectedEvent",
      "description": "View-state activity. Never carries a graph revision or Conversation sequence (REF-042 §23, REF042-RULE-009).",
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "branchId", "conversationId", "cursor", "eventId", "eventType", "occurredAt", "schemaVersion", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.branch.selected" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "actorId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ActorId" },
        "deviceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/DeviceId" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "BranchArchivedEvent": {
      "title": "BranchArchivedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "conversationId", "conversationSequence", "cursor", "eventId", "eventType", "graphRevision", "occurredAt", "schemaVersion", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.branch.archived" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "conversationSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "MessageTombstonedEvent": {
      "title": "MessageTombstonedEvent",
      "description": "A tombstone never implies the Message never existed (REF-042 §25.4).",
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "conversationSequence", "cursor", "eventId", "eventType", "graphRevision", "messageId", "occurredAt", "schemaVersion", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.message.tombstoned" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "messageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "conversationSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "GenerationEvent": {
      "title": "GenerationEvent",
      "description": "Covers `chat.generation.queued`, `chat.generation.started`, `chat.generation.succeeded`, `chat.generation.failed` and `chat.generation.cancelled` (REF-042 §23 `chat.generation.*`). Job-scoped: carries `generationEventSequence` rather than graph revision (REF-042 §23).",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "conversationId", "cursor", "eventId", "eventType", "generationEventSequence", "generationJobId", "occurredAt", "schemaVersion", "triggerMessageId", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": {
          "enum": [
            "chat.generation.queued",
            "chat.generation.started",
            "chat.generation.succeeded",
            "chat.generation.failed",
            "chat.generation.cancelled"
          ]
        },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "generationJobId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobId" },
        "generationAttemptId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationAttemptId" },
        "triggerMessageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "resultMessageId": {
          "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId",
          "description": "Present only on `chat.generation.succeeded` (REF-042 §17.3)."
        },
        "generationEventSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationEventSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "GenerationTextAppendedEvent": {
      "title": "GenerationTextAppendedEvent",
      "description": "One text delta produced in flight by an in-progress Generation Attempt (`chat.generation.text_appended`) and durably recorded so the stream can be replayed. Additive compatible-minor event; existing documents remain valid. Job-scoped like `GenerationEvent`: it carries `generationEventSequence`, never a graph revision, because no result Message is committed yet. Minimised exactly as every other transport event is (REF042-RULE-010): it names no result Message content, no Provider endpoint, model, header or credential, and no raw request/response body, and the closed field set admits no arbitrary metadata. `chunkOrdinal` orders the deltas of one Attempt; `textDelta` is bounded here by character length only, and runtime additionally enforces the stricter cumulative UTF-8 byte bound.",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "chunkOrdinal", "conversationId", "cursor", "eventId", "eventType", "generationAttemptId", "generationEventSequence", "generationJobId", "occurredAt", "schemaVersion", "textDelta", "triggerMessageId", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.generation.text_appended" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "generationJobId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobId" },
        "generationAttemptId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationAttemptId" },
        "triggerMessageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "generationEventSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationEventSequence" },
        "chunkOrdinal": {
          "description": "Zero-based position of this delta within its Generation Attempt's live text stream.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "textDelta": {
          "description": "One bounded appended text fragment of the Generation Attempt's text, durably recorded and used for live streaming and replay. Never the complete committed result: the committed text is carried by the Message graph after `chat.generation.succeeded`.",
          "type": "string",
          "minLength": 1,
          "maxLength": 262144
        },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "GenerationIterationCompletedEvent": {
      "title": "GenerationIterationCompletedEvent",
      "description": "One iteration of a running Generation Attempt finished (`chat.generation.iteration_completed`, C6). Job-scoped like `GenerationEvent`: it carries `generationEventSequence`, never a graph revision, because no Message is committed by an iteration. Identity and counters only, minimised exactly as every other transport event is (REF042-RULE-010): it names no generated text, Direction content, Provider endpoint, model, header or credential. `generationJobVersion` is REQUIRED immutable event-time evidence: the Job's control token as durably recorded when the iteration completed, written into the event payload at that moment. It can never be reconstructed from a later, mutable Job status projection (the Job's `version` advances on every later change), so an event stored without it is invalid rather than back-filled. A consumer holding an older version knows to re-read before stating `expectedGenerationVersion`.",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "conversationId", "cursor", "eventId", "eventType", "generationAttemptId", "generationEventSequence", "generationJobId", "generationJobVersion", "iteration", "occurredAt", "schemaVersion", "triggerMessageId", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.generation.iteration_completed" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "generationJobId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobId" },
        "generationAttemptId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationAttemptId" },
        "triggerMessageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "generationJobVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobVersion" },
        "iteration": {
          "description": "Zero-based position of the iteration that just completed within its Generation Attempt.",
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "generationEventSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationEventSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "DirectionStateChangedEvent": {
      "title": "DirectionStateChangedEvent",
      "description": "A Direction entered a new state (`chat.direction.state_changed`, C6). IDENTITY ONLY: it names the Direction, its scope, the new state and the versions a consumer needs to decide whether to re-read, and it carries no authored content -- no `editableParts`, no text, no `contentHash` and no terminal-reason sentence -- because the Direction is actor-scoped authored content and a transport event is minimised (REF042-RULE-010). The closed field set admits no arbitrary metadata, so content cannot ride in on it. A consumer reads the Direction itself through the actor-scoped `Direction` projection. Job-scoped like `GenerationEvent`: it carries `generationEventSequence`, never a graph revision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "branchId", "conversationId", "cursor", "directionId", "directionVersion", "eventId", "eventType", "generationEventSequence", "generationJobId", "jobSequence", "occurredAt", "schemaVersion", "state", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.direction.state_changed" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "actorId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ActorId" },
        "generationJobId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobId" },
        "directionId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/DirectionId" },
        "jobSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/DirectionJobSequence" },
        "state": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/DirectionState" },
        "directionVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/DirectionVersion" },
        "generationEventSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationEventSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
