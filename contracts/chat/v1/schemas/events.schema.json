{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omnivia.dev/chat/v1/events.schema.json",
  "title": "OmniVia Chat Runtime Contract v1 - Transport event envelopes",
  "description": "Closes CGAP-042-008. Versioned envelopes for the durable Chat transport events named by REF-042 §23, published only after commit and with minimised content (REF042-RULE-010). Every event carries a stable `eventId` for at-least-once consumer dedupe and an opaque `cursor` for stream position; clients round-trip `cursor` verbatim (common.schema.json `OpaqueCursor`). Structural events carry `graphRevision` and `conversationSequence`; Generation events carry `generationEventSequence` instead; `chat.branch.selected` is view-state activity and carries neither (REF-042 §23). Delivery cannot reorder committed events, and an unknown, gapped, expired or unauthorized cursor yields a stable resnapshot response rather than a guessed continuation (CHAT-RUNTIME-CONTRACT-V1-FREEZE.md §9).",
  "type": "object",
  "$defs": {
    "ConversationCreatedEvent": {
      "title": "ConversationCreatedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "conversationSequence", "cursor", "eventId", "eventType", "graphRevision", "occurredAt", "schemaVersion", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.conversation.created" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "conversationSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationSequence" },
        "createdBy": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ActorId" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "MessageCommittedEvent": {
      "title": "MessageCommittedEvent",
      "description": "Minimised: carries identity, lineage and role, never Message Part content (REF-042 §23, §27).",
      "type": "object",
