      }
    },
    "ToolCallStateChangedEvent": {
      "title": "ToolCallStateChangedEvent",
      "description": "A governed tool call entered a new lifecycle state (`chat.tool_call.state_changed`, C8). IDENTITY ONLY, for the reason `DirectionStateChangedEvent` is: it names the call, its turn, the new state and the sequences a consumer needs to decide whether to re-read, and it carries NO prompt, NO tool arguments, NO answer and no digest of any of them. The closed field set admits no arbitrary metadata, and migration 0072's payload CHECK refuses a seventh key, so none of that can ride in. That matters more here than elsewhere: a transport event reaches every reader of the conversation, while the wait behind this state is projected only to an actor its authorised-responder policy admits. A consumer that may answer the wait reads it through `queries.schema.json#/$defs/ToolCallProjection`; one that may not learns the turn is waiting and nothing further. Job-scoped like `GenerationEvent` and `DirectionStateChangedEvent`: it carries `generationEventSequence`, never a graph revision. `reasonCode` is a code, never a sentence -- the line `DirectionStateChangedEvent` draws when it refuses a terminal-reason sentence.",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "conversationId", "cursor", "eventId", "eventType", "generationEventSequence", "generationJobId", "lifecycleSequence", "occurredAt", "schemaVersion", "state", "toolCallId", "turnId", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.tool_call.state_changed" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "generationJobId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationJobId" },
        "toolCallId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceScopedId" },
        "turnId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceScopedId" },
        "state": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpenCode", "description": "The call's new lifecycle state. An open code because the lifecycle is Core's: a consumer meeting an unfamiliar state displays it inertly rather than refusing the event, and 0072 stores it as bounded text for the same reason -- a CHECK listing today's nine would need rebuilding for a tenth." },
        "waitId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceScopedId", "description": "The wait this state involves, where one exists. An opaque identifier only: naming it discloses nothing the `state` does not already say, and nothing about who may answer it." },
        "reasonCode": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpenCode", "description": "Why the call reached this state, as a code. Present only where the lifecycle recorded one." },
        "lifecycleSequence": { "type": "integer", "minimum": 1, "maximum": 1000000, "description": "The call's own append-only lifecycle sequence, so states within one call order independently of the job's event sequence. Bounded as 0072's CHECK bounds it." },
        "generationEventSequence": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GenerationEventSequence" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "ShareCreatedEvent": {
      "title": "ShareCreatedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["branchId", "conversationId", "cursor", "eventId", "eventType", "graphRevision", "headMessageId", "occurredAt", "schemaVersion", "shareId", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.share.created" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "shareId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ShareId" },
        "branchId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/BranchId" },
        "headMessageId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/MessageId" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "ExportCreatedEvent": {
      "title": "ExportCreatedEvent",
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "cursor", "eventId", "eventType", "exportId", "graphRevision", "occurredAt", "schemaVersion", "scope", "workspaceId"],
      "properties": {
        "eventId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/TransportEventId" },
        "eventType": { "const": "chat.export.created" },
        "schemaVersion": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/SchemaVersion" },
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "exportId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ExportId" },
        "scope": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ExportScope" },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "occurredAt": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/Timestamp" },
        "cursor": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor" }
      }
    },
    "ChatEvent": {
      "title": "ChatEvent",
      "description": "The discriminated union of every durable Chat transport event $def, keyed by `eventType` (REF-042 §23, CGAP-042-008). `GenerationEvent` alone represents the five terminal-and-lifecycle `chat.generation.*` discriminators; `GenerationTextAppendedEvent` is the separate closed branch for the live `chat.generation.text_appended` delta, and `GenerationIterationCompletedEvent` and `DirectionStateChangedEvent` are the separate closed, identity-only branches for `chat.generation.iteration_completed` and `chat.direction.state_changed` (C6). Referenced by `bridge.schema.json#/$defs/EventBatchMessage` so F2b forwards only already-defined Chat events and adds no domain meaning of its own (freeze §12).",
      "oneOf": [
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/ConversationCreatedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/MessageCommittedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/MessageDerivationRecordedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/BranchCreatedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/BranchHeadAdvancedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/BranchSelectedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/BranchArchivedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/MessageTombstonedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/GenerationEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/GenerationTextAppendedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/GenerationIterationCompletedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/DirectionStateChangedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/ToolCallStateChangedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/ShareCreatedEvent" },
        { "$ref": "https://contracts.omnivia.dev/chat/v1/events.schema.json#/$defs/ExportCreatedEvent" }
      ]
    },
    "ResnapshotResponse": {
      "title": "ResnapshotResponse",
      "description": "The stable response returned in place of continued delivery when a cursor is unknown, expired, unauthorized or gapped, or when an event carries an unrecognised additive `eventType` a strict consumer cannot safely interpret as a continuation (freeze §9). Never a guessed continuation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["conversationId", "graphRevision", "reason", "resnapshotCursor", "workspaceId"],
      "properties": {
        "workspaceId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/WorkspaceId" },
        "conversationId": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/ConversationId" },
        "reason": {
          "enum": ["cursor_unknown_or_expired", "unauthorized_cursor", "gap_detected", "unrecognised_event_type"]
        },
        "graphRevision": { "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/GraphRevision" },
        "resnapshotCursor": {
          "$ref": "https://contracts.omnivia.dev/chat/v1/common.schema.json#/$defs/OpaqueCursor",
          "description": "The cursor a client resumes from after re-fetching a fresh snapshot."
        }
      }
    }
  }
}
