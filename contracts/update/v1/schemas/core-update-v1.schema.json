{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.omnivia.dev/update/v1/core-update.schema.json",
  "title": "OmniVia Core update channel, trust and operation contract v1",
  "description": "The documents one Core installation reads to decide whether to update, and the documents it writes while updating. The channel document itself is versioned separately and inside: omnivia-core-update.v2 is the signed envelope production verifies, and omnivia-core-update.v1 is the unsigned shape that preceded it, published here so a consumer can see exactly what a development-only policy admits rather than guessing.",
  "type": "object",
  "oneOf": [
    { "$ref": "#/$defs/signedUpdateEnvelope" },
    { "$ref": "#/$defs/unsignedUpdateChannel" },
    { "$ref": "#/$defs/trustedUpdateKey" },
    { "$ref": "#/$defs/updateOperationRecord" },
    { "$ref": "#/$defs/updateTransitionTable" },
    { "$ref": "#/$defs/envelopeCase" },
    { "$ref": "#/$defs/stateCase" },
    { "$ref": "#/$defs/archiveCase" },
    { "$ref": "#/$defs/canonicalVectors" }
  ],
  "$defs": {
    "dottedVersion": {
      "description": "Core's own dotted-integer ordering, the same rule the contract-compatibility windows use. Full PEP 440 pre/post segments are deliberately outside it until a channel needs them.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*$"
    },
    "sha256Hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bundleDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "productId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "channelName": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signatureAlgorithm": { "const": "ed25519" },
    "ed25519PublicKey": {
      "description": "The 32 raw Ed25519 public key bytes in unpadded base64url. 32 bytes is 43 characters, so a length is a shape check and not only a bound; padding is refused because one key must have exactly one spelling.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "ed25519Signature": {
      "description": "The 64 raw Ed25519 signature bytes in unpadded base64url, for the same reason.",
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "httpsUrl": { "type": "string", "maxLength": 2048, "pattern": "^https://" },
    "wheelFilename": {
      "description": "A PEP 427 wheel filename for a first-party pure-Python wheel, as the standard candidate builds them.",
      "type": "string",
      "maxLength": 256,
      "pattern": "^omnivia_[a-z0-9_]+-(0|[1-9][0-9]*)(\\.(0|[1-9][0-9]*))*-py3-none-any\\.whl$"
    },

    "firstPartyPackages": {
      "description": "The exact five first-party distributions the standard candidate installs, each with its own version. The map is carried through to the worker verbatim: a coordinator that synthesised one release version for all five would verify the staged wheels against a version the channel never recommended.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "omnivia-core",
        "omnivia-core-runtime",
        "omnivia-core-client",
        "omnivia-core-cli",
        "omnivia-core-mcp"
      ],
      "properties": {
        "omnivia-core": { "$ref": "#/$defs/dottedVersion" },
        "omnivia-core-runtime": { "$ref": "#/$defs/dottedVersion" },
        "omnivia-core-client": { "$ref": "#/$defs/dottedVersion" },
        "omnivia-core-cli": { "$ref": "#/$defs/dottedVersion" },
        "omnivia-core-mcp": { "$ref": "#/$defs/dottedVersion" }
      }
    },

    "releaseRecommendation": {
      "description": "What one channel recommends. bundle_sha256 is required: an archive this installation cannot identify before unpacking it is an archive it must not unpack.",
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "release_url", "packages", "bundle_sha256"],
      "properties": {
        "version": { "$ref": "#/$defs/dottedVersion" },
        "release_url": { "$ref": "#/$defs/httpsUrl" },
        "packages": { "$ref": "#/$defs/firstPartyPackages" },
        "bundle_sha256": { "$ref": "#/$defs/bundleDigest" }
      }
    },

    "signedUpdateEnvelope": {
      "title": "Signed Core update channel envelope v2",
      "description": "The production channel document. The signature covers the domain-separated canonical JSON of every member except `signature` itself, with the product id inside the domain prefix as well as inside the signed body: a correctly signed envelope for another product cannot be replayed as one for this one even if both were signed by the same key. Strict in both directions -- a missing member and an unknown member are equally refused, because an unknown member is inside the signed bytes and ignoring it would mean verifying a signature over a document that was not read.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "product_id",
        "channel",
        "sequence",
        "issued_at",
        "not_before",
        "not_after",
        "release",
        "signing",
        "signature"
      ],
      "properties": {
        "schema_version": { "const": "omnivia-core-update.v2" },
        "product_id": { "$ref": "#/$defs/productId" },
        "channel": { "$ref": "#/$defs/channelName" },
        "sequence": {
          "description": "Monotonic per channel. A consumer holding a durable floor refuses an envelope at or below it, which is what makes a captured envelope unusable once a later one has been accepted.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "issued_at": { "$ref": "#/$defs/timestamp" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": {
          "description": "The envelope is refused from this instant onward. It bounds how long a correctly signed envelope stays usable, which is the defence a consumer without a durable sequence floor still has against a captured one.",
          "$ref": "#/$defs/timestamp"
        },
        "release": {
          "oneOf": [
            { "$ref": "#/$defs/releaseRecommendation" },
            { "type": "null" }
          ]
        },
        "signing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["key_id", "algorithm"],
          "properties": {
            "key_id": { "$ref": "#/$defs/keyId" },
            "algorithm": { "$ref": "#/$defs/signatureAlgorithm" }
          }
        },
        "signature": { "$ref": "#/$defs/ed25519Signature" }
      }
    },

    "unsignedUpdateChannel": {
      "title": "Unsigned Core update channel v1 (development only)",
      "description": "The shape that preceded the signed envelope. Published so the boundary is readable, not so it stays usable: production refuses it outright, and only a policy that explicitly says it is a test or development policy admits it. bundle_sha256 is optional here, which is one of the reasons v1 is not a production shape.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "channel", "release"],
      "properties": {
        "schema_version": { "const": "omnivia-core-update.v1" },
        "channel": { "$ref": "#/$defs/channelName" },
        "release": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "release_url", "packages"],
              "properties": {
                "version": { "$ref": "#/$defs/dottedVersion" },
                "release_url": { "$ref": "#/$defs/httpsUrl" },
                "packages": { "$ref": "#/$defs/firstPartyPackages" },
                "bundle_sha256": { "$ref": "#/$defs/bundleDigest" }
              }
            },
            { "type": "null" }
          ]
        }
      }
    },

    "trustedUpdateKey": {
      "title": "Approved update signing key v1",
      "description": "An explicit verifier input, never read from the channel being verified: a channel that could nominate the key that verifies it is self-certifying. Rotation is expressed entirely by the windows, so two keys may be approved at once and a transition needs no flag day. Outside its window a key is refused whether it is unknown, not yet valid, expired or retired early, and every direction fails closed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "public_key", "not_before", "not_after"],
      "properties": {
        "key_id": { "$ref": "#/$defs/keyId" },
        "algorithm": { "$ref": "#/$defs/signatureAlgorithm" },
        "public_key": { "$ref": "#/$defs/ed25519PublicKey" },
        "not_before": { "$ref": "#/$defs/timestamp" },
        "not_after": { "$ref": "#/$defs/timestamp" },
        "retired_at": {
          "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }]
        }
      }
    },

    "updatePhase": {
      "enum": [
        "preparing",
        "stopping",
        "installing",
        "restarting",
        "verifying",
        "complete",
        "blocked",
        "failed"
      ]
    },
    "updateOutcome": {
      "enum": ["updated", "blocked", "failed", "restart_required"]
    },

    "updateOperationRecord": {
      "title": "Update operation record v1",
      "description": "The one current-or-last update operation per installation, rewritten at every phase transition. It is a journal, so a reader must be able to tell a record it cannot parse from a record that says nothing happened: an unparseable or shape-invalid record is corruption and never an outcome.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "product_id",
        "installation_ref",
        "approved_release_ref",
        "started_at",
        "phase"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^upd-[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "product_id": { "$ref": "#/$defs/productId" },
        "installation_ref": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "approved_release_ref": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "bundle_sha256"],
          "properties": {
            "version": { "$ref": "#/$defs/dottedVersion" },
            "bundle_sha256": {
              "oneOf": [{ "$ref": "#/$defs/bundleDigest" }, { "type": "null" }]
            }
          }
        },
        "started_at": { "$ref": "#/$defs/timestamp" },
        "phase": { "$ref": "#/$defs/updatePhase" },
        "outcome": { "$ref": "#/$defs/updateOutcome" },
        "finished_at": { "$ref": "#/$defs/timestamp" },
        "failure_code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },

    "updateTransitionTable": {
      "title": "Legal update phase transitions v1",
      "description": "The whole of the phase machine, published rather than implied. Every phase names exactly the phases it may be rewritten to; a terminal phase names none. A record that moves outside this table is an illegal transition, which is a defect in the writer rather than an outcome of the update.",
      "type": "object",
      "additionalProperties": false,
      "required": ["table_version", "initial", "terminal", "transitions"],
      "properties": {
        "table_version": { "const": "1.0" },
        "initial": { "$ref": "#/$defs/updatePhase" },
        "terminal": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/updatePhase" }
        },
        "transitions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "preparing",
            "stopping",
            "installing",
            "restarting",
            "verifying",
            "complete",
            "blocked",
            "failed"
          ],
          "patternProperties": {
            "^[a-z]+$": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/updatePhase" }
            }
          }
        }
      }
    },

    "caseIdentity": {
      "type": "object",
      "required": ["case_version", "case_id", "case_kind", "description"],
      "properties": {
        "case_version": { "const": "1.0" },
        "case_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "case_kind": { "enum": ["envelope", "state", "archive"] },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },

    "envelopeRefusal": {
      "description": "The closed, payload-free vocabulary one refused channel document answers with. A consumer branches on these, so a fourteenth name is a breaking change to this contract rather than a detail. The first twelve are the trust decision; `channel_release_malformed` is the recommendation's shape, which is a separate question asked after the document is believed; `channel_verifier_unavailable` is a consumer that could not ask, which is a refusal and never a pass.",
      "enum": [
        "channel_malformed",
        "channel_unsupported_version",
        "channel_noncanonical",
        "channel_duplicate_member",
        "channel_wrong_product",
        "channel_wrong_channel",
        "channel_untrusted_key",
        "channel_bad_signature",
        "channel_outside_validity",
        "channel_replayed",
        "channel_downgrade",
        "channel_unsigned_refused",
        "channel_release_malformed",
        "channel_verifier_unavailable"
      ]
    },

    "envelopeCase": {
      "title": "Channel-document conformance case v1",
      "description": "A self-contained accept/refuse case. A verifier in any language parses `document_text` as raw bytes -- never as an already-parsed value, because a parsed value cannot carry a duplicate member name or a non-canonical spelling -- applies `policy`, and must produce `expected`.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/caseIdentity" }],
      "required": [
        "case_version",
        "case_id",
        "case_kind",
        "description",
        "document_text",
        "policy",
        "expected"
      ],
      "properties": {
        "case_version": true,
        "case_id": true,
        "case_kind": { "const": "envelope" },
        "description": true,
        "document_text": {
          "description": "The channel document as the exact bytes a consumer fetched, carried as text.",
          "type": "string",
          "maxLength": 65536
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expected_product_id",
            "expected_channel",
            "trusted_keys",
            "verified_at",
            "accept_unsigned_v1"
          ],
          "properties": {
            "expected_product_id": { "$ref": "#/$defs/productId" },
            "expected_channel": { "$ref": "#/$defs/channelName" },
            "trusted_keys": {
              "type": "array",
              "items": { "$ref": "#/$defs/trustedUpdateKey" }
            },
            "verified_at": { "$ref": "#/$defs/timestamp" },
            "accept_unsigned_v1": { "type": "boolean" },
            "minimum_sequence": {
              "oneOf": [{ "type": "integer", "minimum": 1 }, { "type": "null" }]
            },
            "installed": {
              "oneOf": [
                { "$ref": "#/$defs/firstPartyPackages" },
                { "type": "null" }
              ]
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "refusal"],
          "properties": {
            "outcome": { "enum": ["accepted", "refused"] },
            "refusal": {
              "oneOf": [{ "$ref": "#/$defs/envelopeRefusal" }, { "type": "null" }]
            },
            "release": {
              "oneOf": [
                { "$ref": "#/$defs/releaseRecommendation" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },

    "stateCase": {
      "title": "Update operation journal conformance case v1",
      "description": "A record plus a proposed transition, or a record that is corrupt. A verifier reads `record_text` as raw bytes and must produce `expected`: a transition the table permits, a transition it does not, or corruption.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/caseIdentity" }],
      "required": [
        "case_version",
        "case_id",
        "case_kind",
        "description",
        "record_text",
        "expected"
      ],
      "properties": {
        "case_version": true,
        "case_id": true,
        "case_kind": { "const": "state" },
        "description": true,
        "record_text": { "type": "string", "maxLength": 65536 },
        "proposed_phase": { "$ref": "#/$defs/updatePhase" },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome"],
          "properties": {
            "outcome": {
              "enum": [
                "record_admitted",
                "transition_legal",
                "transition_illegal",
                "record_corrupt"
              ]
            },
            "phase": { "$ref": "#/$defs/updatePhase" },
            "outcome_value": {
              "oneOf": [{ "$ref": "#/$defs/updateOutcome" }, { "type": "null" }]
            }
          }
        }
      }
    },

    "archiveRefusal": {
      "description": "Why one candidate bundle must not be unpacked, or must not be trusted once it is. Payload-free and closed, like the channel vocabulary, and grouped by the question each answers: the archive's own shape, then the staging it is written into, then what its own inventory says, then the wheelhouse pip would be pointed at.",
      "enum": [
        "bundle_digest_missing",
        "bundle_checksum_mismatch",
        "bundle_unreadable",
        "bundle_unavailable",
        "archive_unreadable",
        "archive_absolute_member",
        "archive_traversal_member",
        "archive_backslash_member",
        "archive_reserved_member",
        "archive_special_member",
        "archive_duplicate_member",
        "archive_too_many_members",
        "archive_too_large",
        "staging_unavailable",
        "staging_not_owner_only",
        "checksums_missing",
        "checksums_malformed",
        "inventory_member_missing",
        "inventory_digest_mismatch",
        "inventory_incomplete",
        "wheels_missing",
        "wheel_missing",
        "wheel_name_unparseable",
        "wheel_unknown_distribution",
        "wheel_version_missing",
        "wheel_version_mismatch"
      ]
    },

    "archiveCase": {
      "title": "Candidate bundle safety conformance case v1",
      "description": "An archive described by its members rather than carried as bytes, so the corpus stays readable and a verifier in any language can build the same ZIP. `members` is the archive in order, including the members a safe extractor must refuse.",
      "type": "object",
      "additionalProperties": false,
      "allOf": [{ "$ref": "#/$defs/caseIdentity" }],
      "required": [
        "case_version",
        "case_id",
        "case_kind",
        "description",
        "members",
        "bounds",
        "expected"
      ],
      "properties": {
        "case_version": true,
        "case_id": true,
        "case_kind": { "const": "archive" },
        "description": true,
        "approved": {
          "oneOf": [
            { "$ref": "#/$defs/releaseRecommendation" },
            { "type": "null" }
          ]
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "kind"],
            "properties": {
              "name": { "type": "string", "minLength": 1, "maxLength": 1024 },
              "kind": { "enum": ["file", "directory", "symlink"] },
              "content_base64": { "type": "string", "maxLength": 65536 },
              "unix_mode": { "type": "string", "pattern": "^0[0-7]{3,6}$" },
              "declared_size": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_members", "max_expanded_bytes"],
          "properties": {
            "max_members": { "type": "integer", "minimum": 1 },
            "max_expanded_bytes": { "type": "integer", "minimum": 1 }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["outcome", "refusal"],
          "properties": {
            "outcome": { "enum": ["extracted", "refused"] },
            "refusal": {
              "oneOf": [{ "$ref": "#/$defs/archiveRefusal" }, { "type": "null" }]
            },
            "owner_only_staging": { "type": "boolean" }
          }
        }
      }
    },

    "canonicalVectors": {
      "title": "Canonicalisation, base64url and signature vectors v1",
      "description": "Language-neutral vectors proving an independent implementation produces the same canonical bytes, the same signing input and the same signature verdicts. Every JSON input is carried as raw text rather than as a parsed value, because a parsed value cannot distinguish 1.5 from 1 or preserve a duplicate member name.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vectors_version",
        "signature_domain",
        "canonicalisation",
        "base64url",
        "signing_input",
        "signatures"
      ],
      "properties": {
        "vectors_version": { "const": "1.0" },
        "signature_domain": {
          "description": "The ASCII domain prefix. The signing input is this, a NUL, the product id, a NUL, then the canonical JSON of the envelope without its signature.",
          "type": "string",
          "minLength": 1
        },
        "canonicalisation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "json", "accepted"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "json": { "type": "string" },
              "accepted": { "type": "boolean" },
              "canonical": { "type": "string" },
              "sha256": { "$ref": "#/$defs/sha256Hex" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "base64url": {
          "description": "Canonical unpadded base64url. A decoder that accepts padding, the standard alphabet, or non-zero trailing bits accepts more than one spelling of one key or signature, and a signature with two spellings is a signature a filter cannot match.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "text", "expected_bytes", "accepted"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "maxLength": 512 },
              "expected_bytes": { "type": "integer", "minimum": 1 },
              "accepted": { "type": "boolean" },
              "decoded_hex": { "type": "string", "pattern": "^[0-9a-f]*$" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        },
        "signing_input": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "envelope_json",
              "product_id",
              "signing_input_sha256"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "envelope_json": { "type": "string" },
              "product_id": { "$ref": "#/$defs/productId" },
              "signing_input_sha256": { "$ref": "#/$defs/sha256Hex" }
            }
          }
        },
        "signatures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "envelope_json",
              "product_id",
              "public_key",
              "signature",
              "verifies"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "envelope_json": { "type": "string" },
              "product_id": { "$ref": "#/$defs/productId" },
              "public_key": { "$ref": "#/$defs/ed25519PublicKey" },
              "signature": { "$ref": "#/$defs/ed25519Signature" },
              "verifies": { "type": "boolean" },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
